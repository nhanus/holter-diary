{
  "name": "holter-diary",
  "version": "0.0.0",
  "private": true,
  "description": "A minimal local-first Holter monitoring diary",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:build": "vite build --config tests/browser/vite.config.ts",
    "test:serve": "vite preview --config tests/browser/vite.config.ts",
    "test:browser": "npm run test:build && playwright test",
    "test": "npm run test:unit && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
